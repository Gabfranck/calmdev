{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "calmdev",
  "version": "0.1.0",
  "identifier": "ai.calmdev.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "calmdev",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:*; script-src 'self' http://localhost:*; style-src 'self' 'unsafe-inline' http://localhost:*; img-src 'self' data: blob: http://localhost:*; font-src 'self' data: http://localhost:*; connect-src 'self' http://localhost:* ws://localhost:*; frame-src http://localhost:*; object-src 'none'; base-uri 'self'; form-action 'self' http://localhost:*"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREMjY2QzA4QTA3OTUyNjQKUldSa1VubWdDR3dtVFNqVmVRcEpBazVZNUpIVHZZdEwyMVlicXhMT0JPbFJiaFVMUmIzaDV1djgK",
      "endpoints": ["https://github.com/Gabfranck/calmdev/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "calmdev",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
